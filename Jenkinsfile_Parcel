pipeline {
    agent { label 'java_node' }

    tools {
        jdk 'java-11'
        maven 'maven-3'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'feature-1',
                    url: 'https://github.com/priya027v/Parcel-service.git'
            }
        }

        stage('Build') {
            steps {
                sh '''
                    mvn clean install
                '''
            }
        }
    }
}
